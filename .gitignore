# Local Netlify folder
.netlify

# Dependencies and build output
node_modules/
.next/
out/

# Environment files (secrets, per-server Strapi URLs)
.env
.env.*
!.env.example

# Logs and OS files
npm-debug.log*
*.log
.DS_Store
Thumbs.db

*.tsbuildinfo
build/
dist/
.cache/

# === Deploy & security hardening (see DEPLOYMENT.md) ===
# Env & deploy secrets (.env / .env.* already covered above; explicit for clarity)
.env.local
.env.deploy.local
.env.staging
.env.production
# Keys / certs / credentials
*.pem
*.key
*.ppk
credentials*.json
# Databases, dumps, backups, archives
*.sqlite
*.db
*.sql
*.tar.gz
*.zip
.tmp/
backups/
# Runtime uploads (keep the folder, drop its contents)
public/uploads/*
!public/uploads/.gitkeep
