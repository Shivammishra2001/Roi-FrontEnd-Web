# Copy to .env.local (local dev) or .env.production.local (server). Both are
# git-ignored. Restart Next.js after changing them.

# Strapi, server-side (pages and the contact endpoint read it from here).
STRAPI_URL=http://localhost:1338

# Contact-form email notifications (app/contact/submit/route.js), server-side
# only. Leads are always saved in Strapi; if these are unset they just aren't
# emailed. EMAIL_PASS is a Google App Password (16 letters, no spaces), NOT
# the Gmail password: Google Account -> Security -> 2-Step Verification (turn
# on) -> App passwords -> create one, e.g. "ROI Mantra website".
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=abcdefghijklmnop
# Where leads are sent; comma-separate several addresses.
MAIL_RECEIVER=sales@roimantra.com

# Optional: another SMTP server instead of Gmail (e.g. for testing).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
