# Copy to .env.local for local dev. Production values are written by
# deploy/server-setup.sh into .env.production.

# Strapi base URL (no trailing slash, no /api). Content is read server-side,
# with a 60 s revalidation, so CMS edits show up without a rebuild.
NEXT_PUBLIC_STRAPI_URL=http://localhost:1338

# Optional: faster server-to-server address on the production host.
# STRAPI_INTERNAL_URL=http://127.0.0.1:1337

# Shared secret for POST /revalidate (Strapi webhook → instant CMS updates).
# Unset = the endpoint rejects every call; pages still refresh every 60 s.
# REVALIDATE_SECRET=

